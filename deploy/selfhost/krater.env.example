# /srv/krater/prod/krater.env: production on the self-hosted box (deploy/selfhost/README.md). Owner root, mode 600.
# It is both Compose's --env-file (the ${...} in compose.yml) and every app container's env file.
#
# Values marked FROM WEFT must be the ones production runs with today: Jasper decrypts secrets/krater-env.age in
# patchwork/infra and hands them over. A new KRATER_SECRET_KEY signs everyone out and breaks links Krater has
# signed; new S3 keys don't match what's in the store.

# ── This box ──────────────────────────────────────────────────────────────────────────────────────────────────
KRATER_STACK=krater-prod
KRATER_DIR=/srv/krater/prod
# Loopback ports for krater-follow's checks. Staging uses others (3010/3011).
KRATER_PORTAL_PORT=3012
KRATER_STORAGE_PORT=3013
# 1 GB each. weft gave production 50. Keep the box's disk free for at least this much (`df -h /srv`).
KRATER_STORAGE_MAX_VOLUMES=50
KRATER_COMPUTE_STORE_CAPACITY_GB=50

# The database is now the `db` container. New password, made here:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same one in the URL below. Postgres reads POSTGRES_PASSWORD only when it creates an empty data directory.
POSTGRES_PASSWORD=
KRATER_DATABASE_URL=postgresql+psycopg://krater:<POSTGRES_PASSWORD>@db:5432/krater?sslmode=disable

# ── What weft's NixOS module set (infra modules/krater/instance.nix appEnv, hosts/weft/krater.nix) ───────────
KRATER_ENV=production
KRATER_BASE_URL=https://krater.patchworklabs.org
# Cloudflare is the only proxy that appends to X-Forwarded-For now (cloudflared passes it on). weft had 3
# (Cloudflare, Traefik on alastor, nginx on weft). Check it after the cutover (README, "Check it").
KRATER_TRUSTED_PROXY_COUNT=1
KRATER_WEAVE_MODE=live
KRATER_WEAVE_ISSUER=https://weave.patchworklabs.org
KRATER_WEAVE_CLIENT_ID=GwmIPZenHuqRjUjawfJyDYceEcdXDJibTbmEEkuRJDU
KRATER_WEAVE_CLI_CLIENT_ID=xp1VXxTDi-rsRWe9PMrmx75CJn3pOryT3j4RlyKzvnc
KRATER_COMPUTE_MODE=vast
KRATER_VAST_MODE=live
# The scheduler destroys any instance under this prefix that it doesn't know. Never let weft and this box run
# with the same prefix at once (README, "The cutover").
KRATER_COMPUTE_LABEL_PREFIX=krater-prod-
KRATER_COMPUTE_RUNNER_URL=https://krater.patchworklabs.org
KRATER_PRICING_MODE=live
KRATER_SLACK_MODE=live
KRATER_SLACK_FEED_CHANNEL_ID=C0CF4UKJ9EY
KRATER_SLACK_ALERTS_CHANNEL_ID=C0CF352PB17
KRATER_S3_MODE=live
KRATER_S3_ENDPOINT_URL=http://storage:8333
KRATER_S3_PUBLIC_ENDPOINT_URL=https://krater-storage.patchworklabs.org
KRATER_QUILT_URL=https://quilt.patchworklabs.org
KRATER_STASH_URL=https://stash.patchworklabs.org
# alastor still requests https://krater.patchworklabs.org/healthz/edge every minute; it now arrives through the
# tunnel, so it still tells Krater whether runners can reach it.
KRATER_EDGE_PING_EXPECTED=true

# ── FROM WEFT: every KRATER_ key of secrets/krater-env.age that isn't above ──────────────────────────────────
# At least these. Paste the file's other KRATER_ keys too, except KRATER_DATABASE_URL (above, new).
KRATER_SECRET_KEY=
KRATER_WEAVE_CLIENT_SECRET=
KRATER_SLACK_BOT_TOKEN=
KRATER_SLACK_SIGNING_SECRET=
KRATER_S3_ACCESS_KEY_ID=
KRATER_S3_SECRET_ACCESS_KEY=

# Not in this file, each alone in its own file in KRATER_DIR (mode 600):
#   vast-key              FROM WEFT: secrets/krater-vast-key.age, the bare key
#   project-secrets-key   FROM WEFT: secrets/krater-project-secrets-key.age, as is (one Fernet key per line).
#                         A different key loses every stored project secret.
#   tunnel.env            TUNNEL_TOKEN=<the tunnel's token from Cloudflare>
