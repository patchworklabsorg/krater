# Shell scripts must keep LF endings even in a Windows checkout (core.autocrlf=true): WSL and Linux
# bash reject CRLF, and some dev scripts run in WSL2.
*.sh text eol=lf

# Self-hosted fonts are binary; never let autocrlf touch them.
*.woff2 binary

# The self-hosted box copies these onto Linux as they are (deploy/selfhost/README.md).
deploy/selfhost/** text eol=lf
