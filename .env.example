# Copy to `.env` and adjust (or keep it outside the repo and set KRATER_ENV_FILE; see docs/dev/staging.md
# section 4). See krater/config.py for the full list of settings.

KRATER_ENV=development
# In docker-compose, the db host is the `db` service; for `bin/dev` locally, use localhost.
KRATER_DATABASE_URL=postgresql+psycopg://krater:krater@db:5432/krater
# Generate a real one for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses short keys and anything containing "change-me".
KRATER_SECRET_KEY=change-me-in-production
KRATER_BASE_URL=http://localhost:8000

# Weave (Patchwork Labs identity provider). Weave signs people in and owns their Krater roles. Krater asks
# for the scopes `openid profile email groups roles slack`, and uses a client_credentials token (scope
# `directory`) of the same app for the directory API. See docs/weave-integration.md.
# `stub` replaces Weave with a local fixture of fake users; required outside of production.
KRATER_WEAVE_MODE=stub
KRATER_WEAVE_ISSUER=
KRATER_WEAVE_CLIENT_ID=
KRATER_WEAVE_CLIENT_SECRET=
# Base URL of Weave's directory API. Leave blank to use KRATER_WEAVE_ISSUER.
KRATER_WEAVE_API_BASE_URL=
KRATER_WEAVE_STUB_USERS_FILE=

# Krater's role keys on its Weave app, and the group slugs Krater falls back to when Weave sends no
# `roles` field at all. The defaults match the Weave setup in docs/weave-integration.md.
# KRATER_WEAVE_ROLE_MEMBER=member
# KRATER_WEAVE_ROLE_REVIEWER=reviewer
# KRATER_WEAVE_ROLE_ADMIN=admin
# KRATER_WEAVE_GROUP_MEMBER=ganymede-members
# KRATER_WEAVE_GROUP_REVIEWER=krater-reviewers
# KRATER_WEAVE_GROUP_ADMIN=krater-admins

# Which compute layer launches members' machines: `vast` (Krater Compute, docs/compute/) or `off`. Off by default.
KRATER_COMPUTE_MODE=off


# Slack integration (review happens in Slack). See docs/SPEC.md "Slack integration" and
# docs/dev/slack-setup.md. `fake` = in-memory Slack for local dev/tests; required outside of production.
KRATER_SLACK_MODE=fake
# Bot token (`xoxb-...`) for Krater's own Slack app -- see docs/dev/slack-setup.md for the required scopes.
KRATER_SLACK_BOT_TOKEN=
# Signing secret from the app's "Basic Information" page, used to verify requests to /slack/interactions.
KRATER_SLACK_SIGNING_SECRET=
# The master feed channel's id (e.g. `C0123456789`), for the one-line post on each new proposal.
KRATER_SLACK_FEED_CHANNEL_ID=
# How often the worker invites new reviewers (anyone granted ganymede:reviewer in Krater), posts missed
# budget warnings, and archives channels of projects that were missed.
KRATER_SLACK_RECONCILE_INTERVAL_MINUTES=10

# S3-compatible object storage for gallery screenshots. See docs/dev/storage.md.
# docker-compose runs a temporary SeaweedFS container as `storage`. The app talks to it on the internal endpoint;
# browsers get presigned URLs on the public one. Change the secret for anything beyond local dev.
# `live` uses that container; `fake` is in-memory and hands browsers unusable `fake://` upload URLs.
KRATER_S3_MODE=live
KRATER_S3_ENDPOINT_URL=http://storage:8333
KRATER_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
KRATER_S3_REGION=us-east-1
KRATER_S3_BUCKET=krater-screenshots
KRATER_S3_ACCESS_KEY_ID=krater
KRATER_S3_SECRET_ACCESS_KEY=krater-dev-secret

# docker-compose only: the `db` service's own credentials.
POSTGRES_USER=krater
POSTGRES_PASSWORD=krater
POSTGRES_DB=krater
PORT=8000

# Production only (docs/dev/production.md). Leave unset for dev and staging.
# Set to 127.0.0.1 so published ports are reachable only from the host, behind the TLS proxy.
# KRATER_BIND_ADDRESS=127.0.0.1
# Number of reverse proxies in front of the portal (1 with the `proxy` profile), for rate limiting.
# KRATER_TRUSTED_PROXY_COUNT=1
# SeaweedFS version; defaults to 4.47, the one staging ran. Change it only after a staging run, never to `latest`.
# SEAWEEDFS_VERSION=4.47
# `--profile proxy`: the public hostnames Caddy gets certificates for.
# KRATER_DOMAIN=krater.example.org
# KRATER_S3_DOMAIN=storage.krater.example.org
# `--profile backup`: where nightly database dumps go, how often, and how long they're kept.
# KRATER_BACKUP_DIR=/srv/krater/backups
# KRATER_BACKUP_INTERVAL_SECONDS=86400
# KRATER_BACKUP_KEEP_DAYS=14

# The public GPU price catalog behind /pricing and the budget estimator (docs/dev/pricing.md). `live` fetches it
# from GitHub; production refuses `fake`. KRATER_SKYPILOT_MODE still works as the old name for one release.
KRATER_PRICING_MODE=fake
